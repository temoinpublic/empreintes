# La glane quotidienne des actes des communes (D-178), sur le VPS.
# Pose : clone public dans /var/lib/glane-actes/empreintes, jeton dans
# /etc/glane-actes.env (JETON_FLOTTE=..., droits 600, valeur du coffre
# TEMOINPUBLIC_JETON_FLOTTE), etat dans /var/lib/glane-actes/etat.
[Unit]
Description=Glane des actes des communes (temoinpublic.fr, D-178)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=debian
EnvironmentFile=/etc/glane-actes.env
# Une ligne au journal toutes les 12 min au plus (7 jours au 2026-10-28) : muette 1 h, la glane est bloquee (D-229).
Environment=PASSAGES_MUET=1h
WorkingDirectory=/var/lib/glane-actes/empreintes
ExecStartPre=/usr/bin/git -C /var/lib/glane-actes/empreintes pull --ff-only --quiet
ExecStart=/opt/node22/bin/node --max-old-space-size=384 scripts/glaner-actes.mjs --departements tous --etat /var/lib/glane-actes/etat --paralleles 30 --par-commune 15
MemoryMax=512M
CPUQuota=50%
Nice=10
TimeoutStartSec=20h
